generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum Role {
  ADMIN
  USER
}

enum FrameworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum ItemStatus {
  NOT_STARTED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NOT_COMPLIANT
  NOT_APPLICABLE
}

enum ReportType {
  COMPLIANCE_READINESS
  EXECUTIVE_SUMMARY
}

enum ReportFormat {
  PDF
  WEB
}

enum AIType {
  COMPLIANCE_MAPPING
  REMEDIATION_PLAN
  REPORT_NARRATIVE
}

enum RemediationPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RemediationStepStatus {
  TODO
  IN_PROGRESS
  DONE
}

// --- Users ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          Role      @default(USER)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizations    Organization[]
  assessments      Assessment[]
  remediationPlans RemediationPlan[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// --- Organizations ---

model Organization {
  id     String @id @default(cuid())
  userId String // profile owner
  name   String // workspace/company name

  // progressive business profile, filled during onboarding
  productName     String?
  description     String?
  services        String?
  targetCustomers String?
  problemSolved   String?

  // compliance scope — stored as postgres text arrays
  dataHandled String[] @default([])
  regions     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  assessments Assessment[]

  @@index([userId])
  @@index([name])
  @@index([createdAt])
  @@map("organizations")
}

// --- Frameworks & Controls ---

model Framework {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  description   String
  region        String
  category      String
  version       String
  effectiveDate DateTime
  sourceLink    String?
  status        FrameworkStatus @default(DRAFT)
  publishedAt   DateTime? // set when status transitions to PUBLISHED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  controls Control[]

  @@index([code])
  @@index([region])
  @@index([category])
  @@index([status])
  @@map("frameworks")
}

model Control {
  id          String   @id @default(cuid())
  frameworkId String
  code        String // unique per framework, e.g. GDPR-7.1
  title       String
  description String
  category    String?
  severity    Severity @default(MEDIUM)
  weight      Float    @default(1.0) // scoring weight, range 0.1–10.0
  metadata    Json?
  isGateway   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  framework           Framework           @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  assessmentItems     AssessmentItem[]
  remediationPlans    RemediationPlan[]
  gatewayDependencies ControlDependency[] @relation("GatewayDependencies")
  subDependencies     ControlDependency[] @relation("SubControlDependencies")

  @@unique([frameworkId, code])
  @@index([frameworkId])
  @@index([severity])
  @@map("controls")
}

// --- Assessments ---

model Assessment {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  status         AssessmentStatus @default(IN_PROGRESS)
  score          Float? // weighted 0–100; null until at least one item is evaluated
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user             User                 @relation(fields: [userId], references: [id])
  organization     Organization         @relation(fields: [organizationId], references: [id])
  items            AssessmentItem[]
  reports          Report[]
  aiInteractions   AIInteraction[]
  scoreLogs        AssessmentScoreLog[]
  remediationPlans RemediationPlan[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)], map: "assessments_userId_createdAt_desc_idx")
  @@map("assessments")
}

model AssessmentItem {
  id            String     @id @default(cuid())
  assessmentId  String
  controlId     String
  status        ItemStatus @default(NOT_STARTED)
  comments      String?
  owner         String?
  targetDate    DateTime?
  remarks       String?
  evidenceNotes String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control         Control          @relation(fields: [controlId], references: [id])
  evidence        Evidence[]
  remediationPlan RemediationPlan?
  discussionComments Comment[]

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
  @@index([controlId])
  @@index([status])
  @@index([assessmentId, status], map: "assessment_items_assessmentId_status_idx")
  @@map("assessment_items")
}

model AssessmentScoreLog {
  id              String   @id @default(cuid())
  assessmentId    String
  overallScore    Float
  frameworkScores Json // Stores an array of { frameworkCode: "GDPR", score: 85 }
  createdAt       DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([createdAt])
  @@index([assessmentId, createdAt(sort: Desc)], map: "assessment_score_logs_assessmentId_createdAt_desc_idx")
  @@map("assessment_score_logs")
}

model ControlDependency {
  id              String @id @default(cuid())
  parentControlId String
  childControlId  String
  triggerValue    String
  effect          String

  parentControl Control @relation("GatewayDependencies", fields: [parentControlId], references: [id], onDelete: Cascade)
  childControl  Control @relation("SubControlDependencies", fields: [childControlId], references: [id], onDelete: Cascade)

  @@unique([parentControlId, childControlId])
  @@index([parentControlId])
  @@index([childControlId])
  @@map("control_dependencies")
}

// --- Evidence ---

model Evidence {
  id               String   @id @default(cuid())
  assessmentItemId String
  userId           String // uploader — denormalized for audit queries
  filename         String
  originalName     String
  fileUrl          String // S3 object URL
  fileSize         Int // bytes
  mimeType         String
  description      String?
  uploadedAt       DateTime @default(now())

  assessmentItem AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)

  @@index([assessmentItemId])
  @@index([uploadedAt])
  @@map("evidence")
}

model Comment {
  id               String   @id @default(cuid())
  assessmentItemId String
  userId           String
  userName         String
  content          String
  createdAt        DateTime @default(now())
  
  assessmentItem AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  
  @@index([assessmentItemId])
  @@index([assessmentItemId, createdAt(sort: Desc)])
  @@map("comments")
}

// --- Reports ---

model Report {
  id           String       @id @default(cuid())
  assessmentId String
  type         ReportType
  format       ReportFormat
  fileUrl      String? // S3 URL; populated for PDF, null for WEB
  generatedAt  DateTime     @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([generatedAt])
  @@map("reports")
}

// --- Remediation Plans ---

model RemediationPlan {
  id                String                @id @default(cuid())
  assessmentId      String
  assessmentItemId  String                @unique
  controlId         String
  userId            String
  title             String
  summary           String?
  status            RemediationPlanStatus @default(ACTIVE)
  policies          String[]              @default([])
  technicalControls String[]              @default([])
  generatedAt       DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  assessment     Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentItem AssessmentItem    @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  control        Control           @relation(fields: [controlId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
  steps          RemediationStep[]

  @@index([assessmentId])
  @@index([controlId])
  @@index([userId])
  @@index([status])
  @@map("remediation_plans")
}

model RemediationStep {
  id             String                @id @default(cuid())
  planId         String
  title          String
  description    String
  priority       String
  owner          String
  estimatedHours Int
  status         RemediationStepStatus @default(TODO)
  sortOrder      Int
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  plan RemediationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([planId, status])
  @@index([completedAt])
  @@map("remediation_steps")
}

// --- AI Interactions ---

model AIInteraction {
  id           String   @id @default(cuid())
  assessmentId String? // nullable — framework mapping runs before an assessment is created
  type         AIType
  input        String // JSON-stringified prompt payload
  output       String // JSON-stringified parsed LLM response
  model        String
  tokensUsed   Int?
  durationMs   Int?
  createdAt    DateTime @default(now())

  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_interactions")
}
